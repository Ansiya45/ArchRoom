NODE_ENV="development"
PORT="3001"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://untrained-ahoy-blazer.ngrok-free.dev"

# Private server-only values. Never expose these through VITE_ variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
JWT_SECRET="generate-a-long-random-value"
JWT_EXPIRES_IN="1h"

# Required for private host-only meeting recording storage.
SUPABASE_URL="https://PROJECT_REFERENCE.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="meeting-recordings"
SUPABASE_CHAT_FILES_BUCKET="meeting-chat-files"

# LiveKit Cloud or self-hosted LiveKit. Keep the API secret server-side.
LIVEKIT_URL="wss://YOUR_PROJECT.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# Required for verification, password reset, and transcript emails.
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="YLAAM-MEET <onboarding@resend.dev>"
TRANSCRIPT_EMAIL_FROM="YLAAM-MEET <onboarding@resend.dev>"

# Optional Phase 4 scheduling emails. Run the separate notification worker after migration.
APP_PUBLIC_URL="https://your-ylaam-domain.example"
MEETING_EMAIL_FROM="YLAAM-MEET <meetings@your-verified-domain.example>"

# Meeting speech processing (backend only; never expose in VITE_* variables)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
