NODE_ENV="development"
PORT="3001"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://untrained-ahoy-blazer.ngrok-free.dev"

# Private server-only values. Never expose these through VITE_ variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
JWT_SECRET="generate-a-long-random-value"
JWT_EXPIRES_IN="1h"

# Required for private host-only meeting recording storage.
SUPABASE_URL="https://PROJECT_REFERENCE.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="meeting-recordings"
SUPABASE_CHAT_FILES_BUCKET="meeting-chat-files"

# LiveKit Cloud or self-hosted LiveKit. Keep the API secret server-side.
LIVEKIT_URL="wss://YOUR_PROJECT.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
