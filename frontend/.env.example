# Public URL of the Node/tRPC backend. This is not a credential.
# Leave empty for local/ngrok development to use Vite's same-origin /api proxy.
VITE_API_BASE_URL=""

# Required for reliable calls between different networks. Obtain these from
# your TURN provider. Multiple TURN URLs can be comma-separated.

# Optional Google Drive recording upload (public browser configuration).
# Use a Web OAuth client, restricted Picker API key, and Cloud project NUMBER.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_APP_ID=
